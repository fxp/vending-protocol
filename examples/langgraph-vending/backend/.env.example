# Vending machine agent configuration
# Copy to .env and fill in BIGMODEL_API_KEY

# LLM (BigModel GLM-5.1)
BIGMODEL_API_KEY=your-key-here
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_MODEL=glm-5.1

# Vending backend (deployed Cloudflare Workers)
UCP_MOCK_URL=https://ucp-mock.fxp007.workers.dev
SUPPLY_CHAIN_URL=https://supply-chain-mock.fxp007.workers.dev
UCP_CLIENT_SECRET=secret

# Port (only needed if running the HTTP server)
PORT=8000
